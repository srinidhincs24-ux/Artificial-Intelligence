#include <stdio.h>

char board[3][3] = {
    {'1','2','3'},
    {'4','5','6'},
    {'7','8','9'}
};

int win(char p)
{
    int i;

    if (board[0][0] == p && board[1][1] == p && board[2][2] == p)
        return 1;

    if (board[0][2] == p && board[1][1] == p && board[2][0] == p)
        return 1;

    for (i = 0; i < 3; i++)
    {
        if (board[i][0] == p && board[i][1] == p && board[i][2] == p)
            return 1;

        if (board[0][i] == p && board[1][i] == p && board[2][i] == p)
            return 1;
    }

    return 0;
}

void display()
{
    printf("\n");
    printf(" %c | %c | %c\n", board[0][0], board[0][1], board[0][2]);
    printf("---|---|---\n");
    printf(" %c | %c | %c\n", board[1][0], board[1][1], board[1][2]);
    printf("---|---|---\n");
    printf(" %c | %c | %c\n", board[2][0], board[2][1], board[2][2]);
}

int main()
{
    int moves = 0;
    int input, row, column;
    int i, j;

    while (moves < 9)
    {
        display();

        printf("\nEnter position for X: ");
        scanf("%d", &input);

        if (input < 1 || input > 9)
        {
            printf("Invalid position\n");
            continue;
        }

        row = (input - 1) / 3;
        column = (input - 1) % 3;

        if (board[row][column] == 'X' || board[row][column] == 'O')
        {
            printf("Position already occupied\n");
            continue;
        }

        board[row][column] = 'X';
        moves++;

        if (win('X'))
        {
            display();
            printf("\nHuman wins\n");
            return 0;
        }

        if (moves == 9)
            break;

        for (i = 0; i < 3; i++)
        {
            for (j = 0; j < 3; j++)
            {
                if (board[i][j] != 'X' && board[i][j] != 'O')
                {
                    board[i][j] = 'O';
                    moves++;
                    i = 3;
                    break;
                }
            }
        }

        if (win('O'))
        {
            display();
            printf("\nComputer wins\n");
            return 0;
        }
    }

    display();
    printf("\nDraw\n");

    return 0;
}
