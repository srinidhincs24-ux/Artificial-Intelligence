#include <stdio.h>

int main()
{
    int A, B, location;

    printf("Enter status of Room A (0=Clean, 1=Dirty): ");
    scanf("%d", &A);

    printf("Enter status of Room B (0=Clean, 1=Dirty): ");
    scanf("%d", &B);

    printf("Enter vacuum location (0=A, 1=B): ");
    scanf("%d", &location);

    while (A == 1 || B == 1)
    {
        if (location == 0)
        {
            if (A == 1)
            {
                printf("Suck dust from Room A\n");
                A = 0;
            }
            else
            {
                printf("Move Right\n");
                location = 1;
            }
        }
        else
        {
            if (B == 1)
            {
                printf("Suck dust from Room B\n");
                B = 0;
            }
            else
            {
                printf("Move Left\n");
                location = 0;
            }
        }
    }

    printf("Goal Reached: Both rooms are clean\n");

    return 0;
}
